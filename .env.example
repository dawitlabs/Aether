# scripts/local_neo4j.py init generates .env with a random local password.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-password
NEO4J_DATABASE=neo4j

# LLM extraction: any OpenAI-compatible endpoint. Defaults use local Ollama
# (gpt-oss:120b-cloud is on Ollama's free tier; run `ollama signin` first).
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gpt-oss:120b-cloud
LLM_API_KEY=
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_MODEL=all-minilm
EMBED_API_KEY=
# Chat responses are cached here; delete the directory to clear it.
LLM_CACHE_DIR=.local/llm-cache
