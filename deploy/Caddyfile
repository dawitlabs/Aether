# setup.sh replaces AETHER_HOST; Caddy obtains its TLS certificate automatically.
AETHER_HOST {
	# Caps every route; the app itself only bounds /documents uploads (1 MiB).
	request_body {
		max_size 2MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy 127.0.0.1:8000
}
